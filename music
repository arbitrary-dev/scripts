#!/bin/zsh

# In God We Trust †
#
# A.D. MMXXVI
#
#
# To use define an alias:
# alias mus="noglob music"

setopt EXTENDED_GLOB

_ffind() {
	find "$@" -type f -and \(  \
		-iname     "*.mp3"     \
		-or -iname "*.m4a"     \
		-or -iname "*.flac"    \
		-or -iname "*.webm"    \
		-or -iname "*.mp4"     \
		-or -iname "*.mkv"     \
	\)
}

_all() {
	find -L "$dir" \
		\( \
			-name "БÍБЛЇА" \
			-o -name "Church" \
		\) -prune \
		-o -type d -links 2 -print
}

_mus_find() {
	(( `printf "$1" | wc -m` < 3 )) \
	&& >&2 echo "Try more letters!" \
	&& return

	# Case-sensitive search
	unset cs
	echo $1 | grep -q "[A-ZАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ]" && local cs

	local fs
	if [[ "$1" != */* ]]; then
		# Search for directories first
		fs=(${(@fo)"$(find -L "$dir" -type d -${cs-i}name "*$1*")"})
		# ...then file names
		(( ! $#fs )) && fs=(${(@fo)"$(_ffind "$dir"/ -${cs-i}name "*$1*")"})
	fi
	# ...then path names for dirs
	(( ! $#fs )) && fs=(${(@fo)"$(find -L "$dir" -type d -${cs-i}path "*$1*")"})
	(( ! $#fs )) && fs=(${(@fo)"$(find -L "$dir" -type d -${cs-i}path "*${1%%/}*")"})
	# ...then path names for files
	(( ! $#fs )) && fs=(${(@fo)"$(_ffind -L "$dir" -${cs-i}path "*$1*")"})

	while (( $#fs > 1 )) && [[ "$1" != *\** ]] && [[ ! -v list ]]; do
		local i=1
		for f in $fs; do
			>&2 echo $i. ${f#"$dir"/}
			i=$((i + 1))
		done

		>&2 echo
		>&2 read \?"Which one? [s"
		[ -z "$REPLY" ] && >&2 echo "[uall"
		>&2 echo

		case "$REPLY" in
			all|) break ;;
			q) return ;;
			*)	# The pattern <-> is zsh-ism which matches any string
				# having any number of digits and only digits.
				if [[ "$REPLY" = <-> ]]; then
					fs=("${fs[$REPLY]}")
				else
					fs=(${(M)fs:#*(#l)$REPLY*})
				fi ;;
		esac
	done

	if (( ! $#fs )); then
		>&2 echo "No matches found!"
		return
	fi

	for f in $fs; do echo $f; done
}

local dir=${MUS:-~/Music}
local args=()

while true; do
	case "$1" in
		s)
			args+=( --shuffle )
			echo "Playlist will be shuffled!"
			;;
		l|lp)
			local loop
			echo "Loop enabled."
			;;
		ls)
			local list
			;;
		ly)
			fs=(${(@fo)"$(find "$dir"/_lyrics -type f -iname "*$2*.txt")"})
			[ -z "$2" ] && echo "${dir/~/~}/_lyrics/"
			for f in $fs; do
				if [ -z "$2" ]; then
					basename ${f%.txt}
				else
					echo
					basename ${f%.txt}
					basename ${f%.txt} | sed s/./=/g
					echo
					column -L $f
					echo
				fi
			done
			return 0
			;;
		*)
			break
			;;
	esac
	shift
done

if (( ! $# )); then
	ls "$dir" | less -F
	return
fi

local files=()
while (( $# )); do
	if [ "$1" = "*" ]; then
		files+=(${(@f)"$(_all)"})
	else
		files+=(${(@f)"$(_mus_find "${1//./?}")"})
	fi
	shift
done
(( ! $#files )) && return 1

if [[ -v list ]]; then
	for f in "${files[@]}"; do
		if [[ -d "$f" ]]; then
			[[ -v sep ]] && echo
			echo "${f#"$dir"/}/"
			ls "$f"
			sep=2
		else
			[[ "$sep" == 2 ]] && echo
			echo "${f#"$dir"/}"
			sep=1
		fi
	done \
	| less -F
else
	if [ $#files = 1 ]; then
		echo "${files/~/~}"
		[ -v loop ] && args+=( --loop )
	elif (( $#files > 1 )) && [ -v loop ]; then
		args+=( --loop-playlist )
	fi
	mpv --title='${chapter-metadata/title:${media-title}}' \
		${=args[@]} "${files[@]}"
fi
